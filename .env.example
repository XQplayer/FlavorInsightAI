# Server process only. Never use VITE_ for OPENAI_API_KEY.
FLAVOR_AI_MODE=mock
# Optional local-only real API validation without Supabase sign-in.
# Never enable on a public server; private task tools stay unavailable to guests.
FLAVOR_AI_ALLOW_LOCAL_REAL=false
OPENAI_API_KEY=
# Set a model ID that is available to your OpenAI account before real testing.
OPENAI_MODEL=
FLAVOR_AI_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
FLAVOR_AI_SUPABASE_URL=
FLAVOR_AI_SUPABASE_ANON_KEY=
FLAVOR_AI_MAX_INPUT_CHARS=4000
FLAVOR_AI_MAX_OUTPUT_TOKENS=1000
FLAVOR_AI_TIMEOUT_SECONDS=35
FLAVOR_AI_REQUESTS_PER_MINUTE=8
FLAVOR_AI_REQUESTS_PER_DAY=40
FLAVOR_AI_CONCURRENT_PER_USER=2
# Optional verified price inputs; without them cost is shown as unavailable.
FLAVOR_AI_INPUT_USD_PER_MILLION=0
FLAVOR_AI_CACHED_INPUT_USD_PER_MILLION=0
FLAVOR_AI_OUTPUT_USD_PER_MILLION=0
# Public build flag for local/internal PCA pilot only. Production remains off
# until the R service, auth, persistence and permission gates are verified.
# Set VITE_AI_PCA_ENABLED=true only for an explicitly controlled frontend build.
VITE_ANALYSIS_API_URL=
# Hosted PCA service only. Never put the server secret in a VITE_ variable.
FLAVOR_AI_PCA_ENABLED=false
# Required for the first hosted pilot; run one service instance only.
FLAVOR_AI_PCA_SINGLE_INSTANCE=false
FLAVOR_AI_PCA_PROJECT_REF=
FLAVOR_AI_PCA_SUPABASE_SECRET_KEY=
ANALYSIS_RSCRIPT=
